rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requesting user is admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email == 'abdedz20192020@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection (إدارة المستخدمين والأدوار)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow read, write: if isAdmin();
    }

    // Places Collection (الأماكن والحاويات)
    match /places/{placeId} {
      allow read: if true; // Public map reads approved items
      // Citizens can create submissions strictly as pending
      allow create: if request.auth != null && (request.resource.data.status == 'pending' || request.resource.data.verified == false);
      // Only Admin can approve, reject, or update statuses
      allow update, delete: if isAdmin();

      // Confirmations subcollection ("ما زالت هنا")
      match /confirmations/{confirmUid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == confirmUid;
        allow update, delete: if isAdmin();
      }
    }

    // Place Reports (الشكاوى والبلاغات)
    match /placeReports/{reportId} {
      allow read: if (request.auth != null && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Demand / Need Bin Votes (تصويت طلب حاوية في الحي)
    match /needBinVotes/{voteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- دوال التحقق المساعدة (Helper Functions) ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isNotBanned() {
      return isAuthenticated() && 
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         getUserData(request.auth.uid).isBanned != true);
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData(request.auth.uid).role == 'admin';
    }

    function isMunicipality() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData(request.auth.uid).role == 'municipality';
    }

    function inLaghouat(loc) {
      return loc != null &&
        loc.latitude is number &&
        loc.longitude is number &&
        loc.latitude >= 33.70 &&
        loc.latitude <= 33.90 &&
        loc.longitude >= 2.75 &&
        loc.longitude <= 3.00;
    }

    function isValidNeighborhood(nh) {
      return nh == null || (nh is string && nh.size() >= 1 && nh.size() <= 100);
    }

    // --- مجموعة المستخدمين (users) ---
    match /users/{uid} {
      // القراءة: صاحب الحساب أو الأدمن فقط
      allow read: if isOwner(uid) || isAdmin();

      // الإنشاء: صاحب الحساب فقط وممنوع اختيار رتبة غير citizen
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'citizen' &&
        request.resource.data.isBanned == false &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 50 &&
        request.resource.data.createdAt is number &&
        request.resource.data.updatedAt is number;

      // التحديث: صاحب الحساب يمكنه تعديل الاسم، الصورة، اللغة فقط دون لمس الدور أو الحظر
      allow update: if (
        isOwner(uid) &&
        isNotBanned() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'language', 'updatedAt']) &&
        (request.resource.data.displayName == null || 
         (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 50))
      ) || isAdmin();

      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // --- مجموعة الأماكن والحاويات (places) ---
    match /places/{placeId} {
      // القراءة: الأماكن المعتمدة متاحة للجميع، غير المعتمدة يراها صاحبها أو الأدمن
      allow read: if resource.data.verified == true || 
                     (isAuthenticated() && resource.data.addedBy == request.auth.uid) || 
                     isAdmin();

      // الإضافة: المواطن يمكنه إضافة مكان جديد غير موثق فقط وداخل حدود الأغواط
      allow create: if (
        isAuthenticated() &&
        isNotBanned() &&
        request.resource.data.addedBy == request.auth.uid &&
        request.resource.data.verified == false &&
        request.resource.data.owner == 'informal' &&
        request.resource.data.kind in ['bin', 'collection_point', 'wild_dump'] &&
        isValidNeighborhood(request.resource.data.neighborhood) &&
        inLaghouat(request.resource.data.location)
      ) || isAdmin();

      // التعديل: الأدمن (كامل الحقول) أو البلدية (فقط الحالة والتاريخ)
      allow update: if isAdmin() || (
        isMunicipality() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      // الحذف: الأدمن فقط
      allow delete: if isAdmin();

      // تأكيدات المواطنين داخل المكان
      match /confirmations/{confirmUid} {
        allow read: if isAuthenticated();
        allow create: if isOwner(confirmUid) && isNotBanned() && 
                         get(/databases/$(database)/documents/places/$(placeId)).data.verified == true;
        allow update: if false; // لا يوجد تعديل للتأكيد
        allow delete: if isAdmin();
      }
    }

    // --- مجموعة التقارير والشكاوى (placeReports) ---
    match /placeReports/{reportId} {
      // القراءة: صاحب التقرير، الأدمن، أو البلدية
      allow read: if (isAuthenticated() && resource.data.reporterId == request.auth.uid) ||
                     isAdmin() || isMunicipality();

      // الإضافة: المواطن يرسل بحالة 'sent' فقط وتاريخ أولي
      allow create: if isAuthenticated() &&
        isNotBanned() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'sent' &&
        request.resource.data.type in ['broken', 'full', 'dirty_spot'] &&
        isValidNeighborhood(request.resource.data.neighborhood) &&
        inLaghouat(request.resource.data.location) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 1000 &&
        request.resource.data.history.size() == 1 &&
        request.resource.data.history[0].status == 'sent';

      // التعديل: البلدية والأدمن لتغيير الحالة، أو صاحب التقرير لتأكيد الإصلاح
      allow update: if isAdmin() || (
        isMunicipality() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedAt'])
      ) || (
        isAuthenticated() &&
        resource.data.reporterId == request.auth.uid &&
        resource.data.status == 'fixed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reporterConfirmed', 'updatedAt'])
      );

      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // --- تصويت طلب حاوية في الحي (needBinVotes) ---
    match /needBinVotes/{voteId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        isNotBanned() &&
        voteId == (request.resource.data.neighborhood + '_' + request.auth.uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidNeighborhood(request.resource.data.neighborhood);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}

# إعدادات Firebase لتطبيق التويزة (Al-Twiza)
# انسخ هذا الملف إلى .env وضع القيم الخاصة بمشروعك
# تنبيه: لا تقم برفع ملف .env الحقيقي إلى Git أبداً!

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# إعدادات Cloudinary لرفع الصور مجاناً 100%
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=w0xj56ua
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=twizza_uploads
